# EnQuest BBSS classification -- local/dev environment variables.
# Copy this file to .env and fill in real values. Do not commit .env.

# SQL Server connection string for dbo.FormData_Master, as a SQLAlchemy URL.
# Only needed for enquest_main.py / enquest_backfill.py -- NOT needed for
# enquest_local_test.py or enquest_agent_setup.py.
#
# If your password can contain URL-special characters (@, :, /, etc.), or
# you're translating from an ADO.NET/SqlClient-style string (e.g. copied
# from the VS Code mssql extension: "Data Source=...;User ID=...;Password=..."),
# don't hand-build the mssql+pyodbc://user:pass@host/db URL below -- use the
# odbc_connect wrapper instead, which takes a raw, URL-encoded ODBC
# connection string and avoids all the quoting footguns:
#
#   mssql+pyodbc:///?odbc_connect=<url-encoded ODBC connection string>
#
# Build the encoded value locally (never paste a real password into chat):
#   $odbc = "Driver={ODBC Driver 17 for SQL Server};Server=tcp:<host>,1433;Database=<db>;UID=<user>;PWD=<password>;Encrypt=yes;TrustServerCertificate=no"
#   [uri]::EscapeDataString($odbc)
#
# Check `python -c "import pyodbc; print(pyodbc.drivers())"` for which
# driver version is actually installed (17 vs 18) and match the Driver= value.
ENQUEST_BBSS_PROD_CONNECTION=mssql+pyodbc://<user>:<password>@<server>/<database>?driver=ODBC+Driver+17+for+SQL+Server

# Bare Azure AI Foundry PROJECT endpoint -- NOT the longer agent-specific
# URL the Foundry portal shows you (the one ending in
# ".../agents/<name>/endpoint/protocols/openai/responses"). The SDK builds
# that longer URL itself from this endpoint + the agent name below.
# Format: https://<your-resource>.services.ai.azure.com/api/projects/<project-name>
ENQUEST_BBSS_FOUNDRY_PROJECT_ENDPOINT=

# The Agent's name exactly as configured in the Foundry portal
# (e.g. "EnQuestObservationClassifier"). The agent must already exist --
# create/configure it in the portal first; there is no CLI/script for this.
ENQUEST_BBSS_FOUNDRY_AGENT_NAME=

# Optional. Since the endpoint above is already scoped to a specific agent,
# this can usually be left blank -- the agent's own bound model applies.
# Only set it if you need to override that. If you do set it: gpt-4o-mini is
# deprecated for new deployments (2026) -- use gpt-5-mini or gpt-5-nano instead.
ENQUEST_BBSS_FOUNDRY_MODEL_DEPLOYMENT=
